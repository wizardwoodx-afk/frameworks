# Build/runtime artifacts — never commit these.
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
dist/
build/

# Smoke-test leftovers
smoke/python/*.json
smoke/node/package-lock.json

